# ---------------------------------------------------------------------------
# Care Plan Generator API
#
# Copy to .env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# Supabase project
SUPABASE_URL=https://your-project.supabase.co
# Anon key: used only to identify the project when verifying a caller's token.
SUPABASE_KEY=your_supabase_anon_key
# Service role key: bypasses row level security. Server-side only — this must
# never reach the browser or any VITE_-prefixed variable.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Browser origins permitted to call this API, comma separated.
# Must name the deployed frontend in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Model providers
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-opus-5-5

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
